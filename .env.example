WQ_USERNAME=your_username
WQ_PASSWORD=your_password

WQ_API_BASE_URL=https://api.worldquantbrain.com
WQ_API_LOGIN_PATH=/authentication
WQ_API_SIMULATE_PATH=/simulations
WQ_API_STATUS_PATH=/simulations/{simulation_id}
WQ_API_RESULT_PATH=/simulations/{simulation_id}/result

WQ_AUTH_MODE=auto
WQ_CLIENT_MODE=requests
WQ_DRY_RUN=true

WQ_REQUEST_TIMEOUT_SECONDS=60
WQ_RATE_LIMIT_SECONDS=2.0
WQ_MAX_POLL_ATTEMPTS=120
WQ_POLL_INTERVAL_SECONDS=5.0

# Strategy/simulation settings are intentionally not listed here.
# Let the LLM set them per candidate via `simulation_settings`, or per run via `app simulate --...`.

WQ_CANDIDATE_FILE=data/candidates.jsonl
WQ_OUTPUT_DIR=outputs
WQ_LOG_DIR=logs
WQ_FIELDS_CONFIG=config/fields.json
