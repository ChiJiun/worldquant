WQ_USERNAME=your_username
WQ_PASSWORD=your_password
WQ_API_BASE_URL=https://api.worldquantbrain.com
WQ_API_LOGIN_PATH=/authentication
WQ_API_SIMULATE_PATH=/simulations
WQ_API_STATUS_PATH=/simulations/{simulation_id}
WQ_API_RESULT_PATH=/simulations/{simulation_id}/result
WQ_AUTH_MODE=auto
WQ_SIMULATION_TYPE=REGULAR
WQ_INSTRUMENT_TYPE=EQUITY
WQ_REGION=USA
WQ_UNIVERSE=TOP3000
WQ_DELAY=1
WQ_DECAY=0
WQ_NEUTRALIZATION=INDUSTRY
WQ_TRUNCATION=0.08
WQ_PASTEURIZATION=ON
WQ_UNIT_HANDLING=VERIFY
WQ_NAN_HANDLING=OFF
WQ_LANGUAGE=FASTEXPR
WQ_VISUALIZATION=false
WQ_RATE_LIMIT_SECONDS=1.0
WQ_SHARPE_THRESHOLD=1.25
WQ_FITNESS_THRESHOLD=1.0
WQ_DRY_RUN=true
WQ_MAX_POLL_ATTEMPTS=20
WQ_POLL_INTERVAL_SECONDS=3.0
WQ_BATCH_SIZE=5
WQ_POPULATION_SIZE=12
WQ_ELITE_COUNT=3
WQ_IMMIGRANT_RATIO=0.2
WQ_MUTATION_RATE=0.35
WQ_CROSSOVER_RATE=0.7
WQ_GENERATIONS=3
WQ_MINE_CYCLES=1
WQ_MINE_SLEEP_SECONDS=5.0
WQ_SEED_HISTORY_LIMIT=12
WQ_TEMPLATE_WHITELIST=
WQ_TEMPLATE_BLACKLIST=
WQ_CHECKPOINT_EVERY_CYCLES=5
WQ_STORAGE_PATH=data/worldquant.db
WQ_OUTPUT_DIR=outputs
WQ_LOG_DIR=logs
WQ_FIELDS_CONFIG=config/fields.json
WQ_TEMPLATE_CONFIG=config/templates.json
WQ_CLIENT_MODE=auto
